{% set image = page.media.images|first %}
{% set image_align = page.header.image_align|default('right')|replace({'align-': ''}) %}
{% set image_layout = page.header.image_layout|default('columns') %}

<section class="section modular-text image-layout-{{ image_layout }} {{ page.header.class }}">
    <div class="container">
        {% if image and image_layout == 'wrap' %}
            <div class="text-flow align-{{ image_align }}">
                <div class="flow-image">
                    {{ image.html|raw }}
                </div>
                <div class="flow-content">
                    {{ content|raw }}
                </div>
            </div>
        {% else %}
            <div class="columns align-{{ image_align }}">
                {% if image %}
                    <div class="column">
                        {{ content|raw }}
                    </div>
                    <div class="column">
                        {{ image.html|raw }}
                    </div>
                {% else %}
                    <div class="column" style="grid-column: 1 / -1;">
                        {{ content|raw }}
                    </div>
                {% endif %}
            </div>
        {% endif %}
    </div>
</section>
