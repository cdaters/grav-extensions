{% set section_spacing = page.header.section_spacing|default('normal') %}
{% set section_spacing_class = section_spacing == 'tighter' ? 'section-tighter' : (section_spacing == 'tight' ? 'section-tight' : '') %}

<section class="section {{ section_spacing_class }} modular-form {{ page.header.class }}">
    <div class="container">
        <div class="modular-form-inner">
            {{ content|raw }}
            {% if config.plugins.form.modular_form_fix %}
                {% include 'forms/form.html.twig' with {form: forms({route: page.route})} %}
            {% else %}
                {% include 'forms/form.html.twig' %}
            {% endif %}
        </div>
    </div>
</section>
