{% set section_spacing = page.header.section_spacing|default('normal') %}
{% set section_spacing_class = section_spacing == 'tighter' ? 'section-tighter' : (section_spacing == 'tight' ? 'section-tight' : '') %}

<section class="section modular-features {{ section_spacing_class }}" data-layout="{{ page.header.class|default('small') }}">
    <div class="container">
        <div class="frame-box">
            {% set intro_layout = page.header.intro_layout|default('single') %}
            <div class="feature-intro feature-intro-{{ intro_layout }}">
                {{ content|raw }}
            </div>

            <div class="columns">
            {% for feature in page.header.features %}
                <div class="column">
                    {% if feature.url %}<a href="{{ feature.url }}" style="text-decoration:none;color:inherit;display:block;">{% endif %}
                    <div class="feature-icon">
                        {% if feature.icon %}<i class="fa-solid fa-{{ feature.icon }}" aria-hidden="true"></i>{% endif %}
                        {% if feature.header %}<h6>{{ feature.header }}</h6>{% endif %}
                    </div>
                    <div class="feature-content">
                        {% if feature.text %}<p>{{ feature.text }}</p>{% endif %}
                    </div>
                    {% if feature.url %}</a>{% endif %}
                </div>
            {% endfor %}
            </div>
        </div>
    </div>
</section>
